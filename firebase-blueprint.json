{
  "entities": {
    "Admin": {
      "description": "Explicit admin override entries by UID",
      "properties": {
        "email": { "type": "string" }
      }
    },
    "User": {
      "description": "Bazmo registered user profile with guild tier and cascading location",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "tier": { "type": "string" },
        "province": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "active": { "type": "boolean" },
        "createdDateLabel": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "fullName", "tier", "province", "city", "region", "active", "createdAt"]
    },
    "UserInvite": {
      "description": "Pre-provisioned user profile keyed by normalized lowercase email for allowlisted sign-in and profile transfer",
      "properties": {
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "tier": { "type": "string" },
        "province": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "active": { "type": "boolean" },
        "createdDateLabel": { "type": "string" },
        "sourceUserDocId": { "type": "string" },
        "claimedByUid": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "fullName", "tier", "province", "city", "region", "active", "createdAt"]
    },
    "Notification": {
      "description": "Targeted notification broadcast by admin based on location and guild tier",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string" },
        "province": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "tierFilter": { "type": "string" },
        "sectionFilter": { "type": "string" },
        "date": { "type": "string" },
        "readBy": { "type": "array" },
        "published": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "body", "type", "province", "city", "region", "tierFilter", "published", "createdAt"]
    },
    "Store": {
      "description": "Registered mobile, accessory, or hardware merchant store",
      "properties": {
        "name": { "type": "string" },
        "province": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "hours": { "type": "string" },
        "rating": { "type": "string" },
        "type": { "type": "string" },
        "ownerId": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "province", "city", "region", "type", "published", "createdAt"]
    },
    "Mobile": {
      "description": "Mobile phone catalog model",
      "properties": {
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "specs": { "type": "string" },
        "imgEmoji": { "type": "string" },
        "sortOrder": { "type": "number" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["brand", "model", "published", "createdAt"]
    },
    "StoreMobile": {
      "description": "Store pricing offer for a mobile phone model",
      "properties": {
        "storeId": { "type": "string" },
        "mobileId": { "type": "string" },
        "price": { "type": "number" },
        "info": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["storeId", "mobileId", "price", "published", "createdAt"]
    },
    "Accessory": {
      "description": "Mobile accessory catalog item",
      "properties": {
        "cat": { "type": "string" },
        "name": { "type": "string" },
        "storeId": { "type": "string" },
        "price": { "type": "number" },
        "desc": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["cat", "name", "storeId", "price", "published", "createdAt"]
    },
    "Inquiry": {
      "description": "User stock inquiry for an accessory",
      "properties": {
        "accId": { "type": "string" },
        "accName": { "type": "string" },
        "storeName": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["accId", "accName", "storeName", "userId", "status", "createdAt"]
    },
    "SwProblem": {
      "description": "Software repair category tile",
      "properties": {
        "title": { "type": "string" },
        "iconEmoji": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "iconEmoji", "published", "createdAt"]
    },
    "Tutorial": {
      "description": "Software repair tutorial listing",
      "properties": {
        "problemId": { "type": "string" },
        "title": { "type": "string" },
        "teacher": { "type": "string" },
        "rating": { "type": "string" },
        "price": { "type": "number" },
        "terms": { "type": "string" },
        "city": { "type": "string" },
        "status": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["problemId", "title", "teacher", "price", "status", "ownerId", "createdAt"]
    },
    "SwRequest": {
      "description": "Software file or service request",
      "properties": {
        "title": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "city": { "type": "string" },
        "status": { "type": "string" },
        "reply": { "type": "string" },
        "published": { "type": "boolean" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "userId", "city", "status", "published", "createdAt"]
    },
    "Box": {
      "description": "Repair box or dongle marketplace listing",
      "properties": {
        "name": { "type": "string" },
        "price": { "type": "number" },
        "seller": { "type": "string" },
        "city": { "type": "string" },
        "condition": { "type": "string" },
