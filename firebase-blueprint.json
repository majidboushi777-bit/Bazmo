        "ownerId": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "price", "seller", "city", "status", "ownerId", "createdAt"]
    },
    "HwCategory": {
      "description": "Hardware spare part category",
      "properties": {
        "name": { "type": "string" },
        "iconEmoji": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "iconEmoji", "published", "createdAt"]
    },
    "HwAd": {
      "description": "Hardware spare part classified ad",
      "properties": {
        "cat": { "type": "string" },
        "title": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "series": { "type": "string" },
        "price": { "type": "number" },
        "seller": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "province": { "type": "string" },
        "region": { "type": "string" },
        "ownerId": { "type": "string" },
        "ownerName": { "type": "string" },
        "status": { "type": "string" },
        "desc": { "type": "string" },
        "section": { "type": "string" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["cat", "title", "price", "seller", "city", "province", "ownerId", "status", "createdAt"]
    },
    "HwRequest": {
      "description": "Private user special hardware part request",
      "properties": {
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "partType": { "type": "string" },
        "series": { "type": "string" },
        "city": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string" },
        "note": { "type": "string" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["brand", "model", "partType", "series", "userId", "status", "createdAt"]
    },
    "Order": {
      "description": "User purchase order with delivery and customer PII",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "deliveryType": { "type": "string" },
        "customer": { "type": "object" },
        "status": { "type": "string" },
        "date": { "type": "string" },
        "city": { "type": "string" },
        "sortOrder": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "items", "total", "deliveryType", "customer", "status", "createdAt"]
    },
    "ChatThread": {
      "description": "Participant-scoped chat thread for a hardware ad",
      "properties": {
        "adId": { "type": "string" },
        "buyerUid": { "type": "string" },
        "sellerUid": { "type": "string" },
        "participants": { "type": "array" },
        "messages": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["adId", "buyerUid", "sellerUid", "participants", "messages", "createdAt"]
    },
    "ForumPost": {
      "description": "Reddit-style technical community thread for software or hardware boards",
      "properties": {
        "board": { "type": "string" },
        "flair": { "type": "string" },
        "author": { "type": "string" },
        "authorUid": { "type": "string" },
        "authorBadge": { "type": "string" },
        "city": { "type": "string" },
        "deviceTag": { "type": "string" },
        "pinned": { "type": "boolean" },
        "verifiedSolution": { "type": "boolean" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "votes": { "type": "integer" },
        "upvotedBy": { "type": "array" },
        "downvotedBy": { "type": "array" },
        "savedBy": { "type": "array" },
        "createdAtMs": { "type": "number" },
        "timeLabel": { "type": "string" },
        "comments": { "type": "array" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["board", "flair", "author", "authorUid", "title", "body", "votes", "published", "createdAt"]
    },
    "RegistrationRequest": {
      "description": "Pre-login membership verification request submitted from login screen for admin approval",
      "properties": {
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "requestedTier": { "type": "string" },
        "province": { "type": "string" },
        "city": { "type": "string" },
        "region": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["email", "fullName", "phone", "requestedTier", "province", "city", "region", "status", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{adminUid}": { "schema": { "$ref": "#/entities/Admin" }, "description": "Admin role entries" },
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "User profiles" },
    "/user_invites/{inviteId}": { "schema": { "$ref": "#/entities/UserInvite" }, "description": "Pre-provisioned email invites allowlisting login and profile transfer" },
    "/registration_requests/{reqId}": { "schema": { "$ref": "#/entities/RegistrationRequest" }, "description": "Pending membership registration requests awaiting phone verification" },
    "/notifications/{notifId}": { "schema": { "$ref": "#/entities/Notification" }, "description": "Targeted admin notifications" },
    "/stores/{storeId}": { "schema": { "$ref": "#/entities/Store" }, "description": "Merchant stores" },
    "/mobiles/{mobileId}": { "schema": { "$ref": "#/entities/Mobile" }, "description": "Mobile models" },
    "/store_mobiles/{offerId}": { "schema": { "$ref": "#/entities/StoreMobile" }, "description": "Store mobile price offers" },
    "/accessories/{accId}": { "schema": { "$ref": "#/entities/Accessory" }, "description": "Accessories catalog" },
    "/inquiries/{inquiryId}": { "schema": { "$ref": "#/entities/Inquiry" }, "description": "Accessory stock inquiries" },
    "/sw_problems/{problemId}": { "schema": { "$ref": "#/entities/SwProblem" }, "description": "Software problem categories" },
    "/tutorials/{tutorialId}": { "schema": { "$ref": "#/entities/Tutorial" }, "description": "Software tutorials" },
    "/sw_requests/{reqId}": { "schema": { "$ref": "#/entities/SwRequest" }, "description": "Software requests" },
    "/boxes/{boxId}": { "schema": { "$ref": "#/entities/Box" }, "description": "Repair boxes and dongles" },
    "/hw_categories/{catId}": { "schema": { "$ref": "#/entities/HwCategory" }, "description": "Hardware part categories" },
    "/hw_ads/{adId}": { "schema": { "$ref": "#/entities/HwAd" }, "description": "User classified ads across hardware, mobile, and accessories" },
    "/hw_requests/{reqId}": { "schema": { "$ref": "#/entities/HwRequest" }, "description": "Hardware special part requests" },
    "/orders/{orderId}": { "schema": { "$ref": "#/entities/Order" }, "description": "Customer orders" },
    "/chats/{threadId}": { "schema": { "$ref": "#/entities/ChatThread" }, "description": "Buyer-seller chat threads" },
    "/forum_posts/{postId}": { "schema": { "$ref": "#/entities/ForumPost" }, "description": "Technical forum threads" }
  }
}
